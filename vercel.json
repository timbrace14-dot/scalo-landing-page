{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "join.buildwithscalo.com" }],
      "destination": "/sales/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "join.buildwithscalo.com" }],
      "destination": "/sales/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "book.buildwithscalo.com" }],
      "destination": "/book/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "book.buildwithscalo.com" }],
      "destination": "/book/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "post-booking.buildwithscalo.com" }],
      "destination": "/post-booking/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "post-booking.buildwithscalo.com" }],
      "destination": "/post-booking/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "skill-sell-scale.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "skill-sell-scale.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    {
      "source": "/r/:slug",
      "has": [{ "type": "host", "value": "skill-sell-scale.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    { "source": "/", "destination": "/waitlist.html" },
    { "source": "/index.html", "destination": "/waitlist.html" }
  ]
}
