{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/book",
      "destination": "https://businessos.buildwithscalo.com/book"
    },
    {
      "source": "/book/:path*",
      "destination": "https://businessos.buildwithscalo.com/book/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "join.buildwithscalo.com" }],
      "destination": "/sales/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "join.buildwithscalo.com" }],
      "destination": "/sales/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "book.buildwithscalo.com" }],
      "destination": "/book-a-call/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "book.buildwithscalo.com" }],
      "destination": "/book-a-call/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "skill-sell-scale.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "skill-sell-scale.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    {
      "source": "/r/:slug",
      "has": [{ "type": "host", "value": "skill-sell-scale.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "packaged.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "packaged.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    {
      "source": "/r/:slug",
      "has": [{ "type": "host", "value": "packaged.buildwithscalo.com" }],
      "destination": "/skill-sell-scale/index.html"
    },
    { "source": "/", "destination": "/waitlist.html" },
    { "source": "/index.html", "destination": "/waitlist.html" }
  ]
}
