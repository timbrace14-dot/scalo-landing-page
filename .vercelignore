# Exclude anything that would blow up the Vercel upload or isn't used by the sales page.

# Video files (11G+) — not referenced by sales/index.html
*.mov
*.MOV
*.mp4
*.MP4

# Version control + tooling
.git/
.claude/
.github/

# macOS metadata
.DS_Store
._*

# Local notes / docs not needed in deploy
master-context.md

# Root-level waitlist page — we only want the /sales/ page on this Vercel project.
# Leading slash matters: excludes only the root index.html, not sales/index.html.
/index.html

# CNAME is a GitHub Pages marker; Vercel uses its own domain config.
/CNAME

# Folders not referenced by the sales page (keeps upload small + fast)
FAQs/

